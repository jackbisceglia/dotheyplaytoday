# Copy this file to .env and fill in the values.

# Web (packages/web-v2)
PUBLIC_WEB_URL_BASE=http://localhost
PUBLIC_WEB_URL_PORT=4321

# API (packages/api-v2)
PUBLIC_API_URL_BASE=http://localhost
PUBLIC_API_URL_PORT=3001

# Database (better-sqlite3 / Drizzle) — local dev file lives at packages/data/dtpt.sqlite
DATABASE_URL=packages/data/dtpt.sqlite

# Email channel (packages/core-v2, Resend) — required to send notifications
# RESEND_API_KEY=re_xxx
# RESEND_FROM_EMAIL=onboarding@resend.dev

# Rate limiter (packages/api-v2) — defaults shown
# RATE_LIMIT_WRITE_MAX=20
# RATE_LIMIT_WRITE_WINDOW=60

# Dev seed (packages/data) — recipient for the seed:dev notification user
# Defaults to fan@example.com when unset
# SEED_EMAIL=you@example.com
