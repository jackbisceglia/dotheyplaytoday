# Cloudflare provider authentication is also required for infrastructure.
CLOUDFLARE_API_TOKEN="..."
CLOUDFLARE_ACCOUNT_ID="..."

# Notifier
EMAIL_FROM_ADDRESS="dev@dotheyplay.today"
EMAIL_FROM_NAME="dtpt development server"

# Ops
