{
  "name": "@dtpt/core-v2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -w exec vitest run packages/core-v2/src"
  },
  "dependencies": {
    "@effect/sql-sqlite-node": "4.0.0-beta.65",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "1.0.0-rc.3",
    "effect": "4.0.0-beta.65",
    "resend": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-beta.65"
  }
}
