{
  "name": "@dtpt/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -w exec vitest run packages/core/src"
  },
  "dependencies": {
    "@effect/platform-browser": "catalog:",
    "@effect/sql-pg": "catalog:",
    "alchemy": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "resend": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:"
  }
}
