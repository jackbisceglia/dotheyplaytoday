---
import Layout from "../layouts/layout.astro";
import SignupForm from "../modules/signup/Form.astro";
import ScoreTicker from "../modules/ui/ticker.astro";
import { withApiClient } from "../lib/api.js";

export const prerender = false;

const subjects = await withApiClient((client) => client.subjects.list()).catch(
  () => [],
);
---

<Layout
  title="dotheyplaytoday"
  description="Game-day emails for your teams. Pick your team, pick a time, and get an update on game day."
>
  <a class="header-cta" href="#signup" slot="header-action">Sign up</a>

  <section class="hero">
    <h1 class="hero-headline">
      Your team plays<br />
      <em>tonight.</em><br />
      Now you know.
    </h1>
    <p class="hero-copy">
      Pick your team, pick a time, and get an update on game day.
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="#signup">Get game-day updates</a>
    </div>
  </section>

  <ScoreTicker />

  <section class="signup" id="signup">
    <div class="signup-header">
      <h2 class="signup-title">Get on the roster</h2>
    </div>
    <SignupForm subjects={subjects} />
  </section>
</Layout>
