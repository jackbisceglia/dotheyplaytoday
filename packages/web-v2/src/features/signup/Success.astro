<div
  class="signup-success"
  data-success
  hidden
  style="display: none;"
  role="status"
  aria-atomic="true"
>
  <p class="signup-success-mark" aria-hidden="true">✓</p>
  <h3 class="signup-success-title" tabindex="-1" data-success-title>
    You're on the roster
  </h3>
  <p class="signup-success-copy">
    Game-day emails for your teams will land at your chosen time, only on days
    they play.
  </p>
  <p class="signup-success-copy">
    Change your mind later? Sign up again with the same email and your new picks
    replace the old ones.
  </p>
  <button class="btn btn-secondary" type="button" data-edit>
    Edit my picks
  </button>
</div>
