---
import { Result } from "effect";

import UnsubscribeConfirmation from "../../modules/unsubscribe/Confirmation.astro";
import UnsubscribeNotFound from "../../modules/unsubscribe/NotFound.astro";
import { decodeUnsubscribeToken } from "../../modules/unsubscribe/token";
import Layout from "../../layouts/Layout.astro";

export const prerender = false;

const tokenResult = decodeUnsubscribeToken(Astro.params.token);

if (Result.isFailure(tokenResult)) {
  Astro.response.status = 404;
  Astro.response.statusText = "Not Found";
}
---

<Layout
  title="Unsubscribe | dotheyplaytoday"
  description="Confirm that you want to stop dotheyplaytoday emails."
>
  <a class="header-cta" href="/" slot="header-action">Home</a>

  {
    Result.match(tokenResult, {
      onSuccess: (token) => <UnsubscribeConfirmation token={token} />,
      onFailure: () => <UnsubscribeNotFound />,
    })
  }
</Layout>
