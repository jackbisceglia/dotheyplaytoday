{
  "name": "@dtpt/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm --filter @dtpt/core build && pnpm -w exec vitest run packages/api/src"
  },
  "dependencies": {
    "@dtpt/core": "workspace:*",
    "alchemy": "catalog:",
    "better-auth": "1.7.2",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:"
  }
}
