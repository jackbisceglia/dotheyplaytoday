{
  "name": "@dtpt/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "effect-tsgo tsrs@0.20.1-ts7.1.0-beta -p tsconfig.build.json",
    "typecheck": "effect-tsgo tsrs@0.20.1-ts7.1.0-beta --noEmit",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "test": "pnpm --filter @dtpt/core build && pnpm -w exec vitest run packages/api/src"
  },
  "dependencies": {
    "@dtpt/core": "workspace:*",
    "alchemy": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@effect/vitest": "catalog:",
    "@electric-sql/pglite": "0.3.15",
    "@types/pg": "catalog:"
  }
}
