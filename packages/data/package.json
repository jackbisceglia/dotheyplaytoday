{
  "name": "@dtpt/data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "effect-tsgo tsrs@0.20.1-ts7.1.0-beta -p tsconfig.build.json",
    "typecheck": "effect-tsgo tsrs@0.20.1-ts7.1.0-beta --noEmit",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "test": "pnpm --filter @dtpt/core build && pnpm -w exec vitest run packages/data/src"
  },
  "dependencies": {
    "@dtpt/core": "workspace:*",
    "alchemy": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:"
  }
}
