{
  "name": "@dtpt/data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm --filter @dtpt/core build && pnpm -w exec vitest run packages/data/src",
    "seed:dev": "pnpm --filter @dtpt/core build && pnpm build && node dist/seed/cli.js dev",
    "seed:prod": "pnpm --filter @dtpt/core build && pnpm build && node dist/seed/cli.js prod"
  },
  "dependencies": {
    "@distilled.cloud/cloudflare": "^0.26.1",
    "@dtpt/core": "workspace:*",
    "@effect/platform-node": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:"
  }
}
