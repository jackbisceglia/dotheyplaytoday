{
  "name": "dotheyplaytoday",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web-v2": "pnpm @web-v2 dev",
    "dev:api-v2": "pnpm @api-v2 dev",
    "initialize": "pnpm build && node packages/data/dist/seed/cli.js dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "format": "pnpm -r run format",
    "test": "pnpm @core build && pnpm @core-v2 build && vitest run",
    "test:watch": "vitest",
    "@core": "pnpm -F @dtpt/core",
    "@core-v2": "pnpm -F @dtpt/core-v2",
    "@data": "pnpm -F @dtpt/data",
    "@web-v2": "pnpm -F @dtpt/web-v2",
    "@api-v2": "pnpm -F @dtpt/api-v2",
    "@jobs-v2": "pnpm -F @dtpt/jobs-v2",
    "prepare": "pnpm exec effect-language-service patch"
  },
  "devDependencies": {
    "@effect/vitest": "^0.29.0",
    "@effect/language-service": "^0.81.0",
    "@eslint/js": "^9.36.0",
    "@tsconfig/bun": "^1.0.7",
    "@tsconfig/strictest": "^2.0.6",
    "@types/bun": "^1.2.16",
    "effect": "catalog:",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "3.6.2",
    "vitest": "^3.2.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "patchedDependencies": {
      "drizzle-orm@1.0.0-rc.3": "patches/drizzle-orm@1.0.0-rc.3.patch"
    }
  },
  "packageManager": "pnpm@10.11.0"
}
