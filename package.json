{
  "name": "dotheyplaytoday",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "pnpm @web dev",
    "dev:api": "pnpm @api dev",
    "dev:infra": "alchemy dev alchemy.run.ts",
    "deploy": "alchemy deploy alchemy.run.ts",
    "destroy": "alchemy destroy alchemy.run.ts",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "format": "pnpm -r run format",
    "test": "pnpm @core build && vitest run",
    "test:watch": "vitest",
    "@core": "pnpm -F @dtpt/core",
    "@data": "pnpm -F @dtpt/data",
    "@web": "pnpm -F @dtpt/web",
    "@api": "pnpm -F @dtpt/api",
    "@jobs": "pnpm -F @dtpt/jobs",
    "prepare": "pnpm exec effect-language-service patch"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260626.1",
    "@effect/language-service": "catalog:",
    "@effect/vitest": "catalog:",
    "@eslint/js": "^9.36.0",
    "@tsconfig/bun": "^1.0.7",
    "@tsconfig/strictest": "^2.0.6",
    "@types/bun": "^1.2.16",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4",
    "ws": "^8.21.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "patchedDependencies": {
      "drizzle-orm@1.0.0-rc.3": "patches/drizzle-orm@1.0.0-rc.3.patch"
    }
  },
  "packageManager": "pnpm@10.11.0"
}
